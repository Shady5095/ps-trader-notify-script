# ==============================================================
# إعدادات اسكربت مراقبة بلايستيشن 5 على دوبيزل مصر
# ==============================================================

# 1. مفتاح Google Gemini API (مجاني 100% من Google AI Studio)
# احصل عليه من: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# موديل Gemini المستخدم (الافتراضي: gemini-2.5-flash سريع ودقيق ومجاني)
GEMINI_MODEL=gemini-2.5-flash

# 2. إشعارات الموبايل المجانية (اختر Telegram أو ntfy أو الاثنين معاً):

# أ) إشعارات تليجرام (Telegram Bot - الأفضل والأسهل):
# - افتح تليجرام وابحث عن: @BotFather واكتب /newbot لإنشاء بوت والحصول على الـ Token
# - للحصول على الـ Chat ID الخاص بك: راسل البوت @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ب) إشعارات ntfy.sh (بديل فوري بدون أي حساب أو تسجيل):
# - نزل تطبيق ntfy على موبايلك (Android أو iOS)
# - اضغط على + واكتب اسم موضوع سري خاص بك، وضعه هنا:
NTFY_TOPIC=

# 3. الفاصل الزمني للبحث بالدقائق (الافتراضي: 5 دقائق)
CHECK_INTERVAL_MINUTES=5
